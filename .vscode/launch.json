{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Tasklist",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "tasklist.app",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--port",
                "5050"
            ],
            "jinja": true,
            "console": "internalConsole",
            "autoStartBrowser": false
        }
    ]
}
